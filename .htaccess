Options +FollowSymLinks -MultiViews
RewriteEngine On

# Permitir acceso directo a archivos PHP específicos (limpiadores, utilidades)
RewriteCond %{REQUEST_URI} ^/session_cleaner\.php$ [NC]
RewriteRule ^(.*)$ $1 [L]

# Permitir acceso directo a archivos existentes (imágenes, CSS, JS, etc.)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-l

# Redirigir todas las demás solicitudes a index.php
RewriteRule ^(.+)$ index.php?url=$1 [QSA,L]

# Forzar HTTPS (opcional, descomenta la siguiente línea si usas SSL)
# RewriteCond %{HTTPS} off
# RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]